  "question": "How much forest and how much loss sits in the part of Quebec, Ontario, Alberta and British Columbia that the land-cover product never mapped?",
  "answer": "The unmapped part is large in area and nearly empty of forest. Across the whole 10 to 50 percent tree-cover sensitivity band the loss it hides is under 0.21 percent of measured loss in Alberta, under 0.86 percent in Quebec, about 1.02 percent in Ontario, and nil in British Columbia. The gap is worth disclosing, and re-mapping it would not move any published number materially.",
  "source": {
    "product": "Hansen Global Forest Change 2000-2024 v1.12",
    "licence": "CC BY 4.0",
    "attribution": "Source: Hansen/UMD/Google/USGS/NASA",
    "whyThisSource": "It is global, so it has no Canadian mapped-extent gap of its own and can be asked about ground the land-cover product skipped."
  },
  "window": {
    "fromYear": 2001,
    "toYear": 2022,
    "note": "Hansen begins in 2001; 1984-2000 has no independent measurement here."
  },
  "method": {
    "inside": "the part VLCE2 mapped, used as the definitional control",
    "outside": "the part VLCE2 never mapped, the quantity wanted",
    "areaMethod": "spherical cell area per row, authalic radius 6371007.181 m",
    "waterExcluded": "Hansen datamask == 1 (land) only",
    "thresholdsPercentTreeCover2000": [
      10,
      20,
      30,
      50
    ],
    "control": "The inside figures are the control. Hansen and the land-cover product answer the same ground there, so the ratio between them measures how differently the two define forest and loss. A Hansen number in the gap is uninterpretable without it."
  },
  "neverDone": [
    "adding an inside figure to an outside figure",
    "adding any Hansen figure to a land-cover product figure",
    "treating this as coverage of the gap rather than a measurement of it"
  ],
